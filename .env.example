NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
# Use atomic-required only after the environment has an enabled legacy-only
# opportunity lifecycle rollout control. Unset preserves the pre-activation path.
OPPORTUNITY_CREATION_MODE=
OPENAI_API_KEY=
OPENAI_VLM_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_VLM_MODEL=
ANTHROPIC_MATERIAL_SUPPLIER_PRICING_MODEL=claude-sonnet-4-6
MATERIAL_SUPPLIER_PRICING_INTERPRETER=anthropic
MATERIAL_SUPPLIER_PRICING_ALLOW_DETERMINISTIC_FALLBACK=false
UNIVERSAL_LEARNING_DIAGNOSTIC_ORGANIZATION_IDS=
CRON_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
XERO_TOKEN_ENCRYPTION_KEY=
XERO_SCOPES=openid profile email accounting.settings accounting.contacts accounting.invoices accounting.attachments offline_access

# Hosted-development tests only; supply manually through a private environment.
# Never use production accounts. Existing target and mutation acknowledgements still apply.
HOSTED_TEST_OWNER_EMAIL=
HOSTED_TEST_OWNER_PASSWORD=
HOSTED_TEST_MANAGER_EMAIL=
HOSTED_TEST_MANAGER_PASSWORD=

# Separate localhost-only E2E fixture account; set in private .env.test.local.
LOCAL_E2E_OWNER_PASSWORD=
