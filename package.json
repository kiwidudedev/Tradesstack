{
  "name": "tradesstack-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbopack": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:release": "eslint app components hooks lib packages scripts/ops supabase/functions *.mjs *.ts",
    "lint:diagnostic": "eslint .",
    "typecheck:release": "corepack npm exec -- tsc --noEmit --pretty false -p tsconfig.build.json",
    "test:release": "corepack npm exec -- vitest run --config vitest.release.config.ts",
    "test:infrastructure": "corepack npm exec -- vitest run --config vitest.config.ts --dir tests/characterization",
    "test:integration": "corepack npm exec -- vitest run --config vitest.config.ts --dir app --testNamePattern integration",
    "test:hosted": "npm run test:e2e:local",
    "test:e2e:local": "playwright test",
    "report:opportunity-shadow": "node scripts/report-opportunity-promotion-shadow.mjs",
    "report:opportunity-pilot": "node scripts/report-opportunity-promotion-pilot.mjs",
    "audit:promoted-project-metadata": "node scripts/audit-promoted-project-metadata.mjs",
    "manage:opportunity-rollout": "node scripts/manage-opportunity-promotion-rollout.mjs",
    "manage:opportunity-default": "node scripts/manage-opportunity-lifecycle-default.mjs",
    "validate:opportunity-stage6-hosted": "node scripts/run-stage6-hosted-cohort.mjs",
    "validate:opportunity-stage7-default": "node scripts/run-stage7-default-corpus.mjs",
    "audit:learn-over-time:db-catalog": "node --import tsx scripts/audit-learn-over-time-db-catalog.ts",
    "audit:material-price-tax-evidence": "node --import tsx scripts/audit-material-price-tax-evidence.ts",
    "test:pricing-worksheet-ai": "vitest run lib/pricing-worksheet-edit-plan.test.ts",
    "test:core-contracts": "vitest run packages/core-contracts/src/index.test.ts",
    "test:client-config": "vitest run packages/client-config/src/index.test.ts proofs/client-configuration/src/index.test.ts",
    "build:client-config": "npm run build --workspace=@tradesstack/client-config",
    "proof:dedicated-client": "npm --prefix proofs/dedicated-client-provisioning run proof",
    "proof:client-shell-release": "npm --prefix proofs/application-shell-release run proof",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "ops:toolchain": "corepack npm run ops:toolchain:check",
    "ops:toolchain:check": "node scripts/ops/toolchain.mjs",
    "ops:release": "node scripts/ops/release.mjs",
    "ops:registry": "node scripts/ops/registry.mjs",
    "ops:migrations": "node scripts/ops/migrations.mjs",
    "ops:security": "node scripts/ops/security.mjs",
    "ops:drift": "node scripts/ops/drift.mjs",
    "ops:prehosting": "corepack npm run ops:prehosting:check",
    "ops:prehosting:check": "node scripts/ops/prehosting.mjs",
    "ops:validate-release": "corepack npm run ops:validate-release:check",
    "ops:validate-release:check": "node scripts/ops/validate-release.mjs",
    "release:promote": "node scripts/ops/promote-release.mjs",
    "client:register": "node scripts/ops/register-client.mjs",
    "test:client-promotion": "node --test scripts/ops/promote-release.test.mjs",
    "takeoff:worker": "bash scripts/run_takeoff_render_worker.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/mulish": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tailwindcss/postcss": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.545.0",
    "next": "16.3.8",
    "openai": "^6.33.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.10.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.3.1",
    "tus-js-client": "^4.3.1"
  },
  "overrides": {
    "glob": {
      "minimatch": {
        "brace-expansion": "^1.1.21"
      }
    },
    "readdir-glob": {
      "minimatch": {
        "brace-expansion": "^2.1.7"
      }
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20.19.10",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.0.1",
    "pg": "^8.21.0",
    "postcss": "^8.5.6",
    "supabase": "^2.100.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=11.6.2 <12"
  }
}
